# API Keys - DO NOT commit the actual .env file to git!
# Copy this file to .env and fill in your actual keys

# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# OpenRouter API Key (if using OpenRouter)
OPENROUTER_API_KEY=sk-your-key-here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Langfuse tracking (optional)
LANGFUSE_PUBLIC_KEY=pk-your-key-here
LANGFUSE_SECRET_KEY=sk-your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com
